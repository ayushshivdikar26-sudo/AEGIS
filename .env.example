# AEGIS Environment Configuration Example
# Copy this file to .env and configure with your real values.
# NEVER commit your real .env file to version control.

# Application Environment (development | production)
ENVIRONMENT=development

# Supabase Configuration
# Required: Dev/Prod Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Required: Supabase Publishable Key (replaces legacy anon key)
# Format: sb_publishable_... or legacy anon JWT
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Backend Admin Only: Supabase Secret Key (replaces legacy service_role key)
# Used ONLY in isolated admin/test setup scripts, NEVER in standard user routes
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Required for Test Harness (Hard guard: tests refuse to run unless project ref matches)
AEGIS_TEST_PROJECT_REF=your-test-project-ref

# Shared Rate Limiting (Redis URI)
# Required in production (multi-worker deployment).
# In local development, can point to local Redis or a free-tier Upstash Redis instance.
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0

# CORS Allowed Origins
# Comma-separated list of allowed origins. Leave empty in production if frontend is served by FastAPI.
ALLOWED_ORIGINS=

# Security & Cookies
# Set to false ONLY during local development over plain http://localhost.
# In production, must be true.
COOKIE_SECURE=false

# Number of reverse proxies (e.g., Cloudflare, Nginx) to trust for client IP determination
TRUSTED_PROXY_COUNT=0

# AI Analyzer (Optional - Milestone M8, Deferred)
# Set to false for core release (M1-M7). AI features remain disabled.
AI_ENABLED=false

# Groq API Configuration (Read ONLY when AI_ENABLED=true)
GROQ_API_KEY=
GROQ_MODEL=
